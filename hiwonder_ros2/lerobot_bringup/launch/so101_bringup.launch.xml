<?xml version="1.0"?>
<launch>
  <arg name="leader_port" default="/dev/ttyACM0"/>
  <arg name="leader_calibration_path" default="$(find-pkg-share so101_description)/config/leader_example_calibration.yaml"/>
  <arg name="gui" default="false"/>
  <include file="$(find-pkg-share lerobot_bringup)/launch/so101_leader_bringup.launch.py">
    <arg name="namespace" value="leader"/>
    <arg name="port" value="$(var leader_port)"/>
    <arg name="calibration_path" value="$(var leader_calibration_path)"/>
    <arg name="gui" value="$(var gui)"/>
  </include>
</launch>
